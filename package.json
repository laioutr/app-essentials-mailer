{
  "name": "@laioutr/app-essentials-mailer",
  "version": "0.1.0",
  "description": "Laioutr Essentials Mailer — the shared mail backbone for essentials apps; v1 handles withdrawal-form submissions.",
  "repository": "laioutr/app-essentials-mailer",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./server": {
      "types": "./dist/runtime/server/mail/index.d.ts",
      "import": "./dist/runtime/server/mail/index.js"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "npm run dev:prepare && nuxi dev playground",
    "dev:build": "nuxi build playground",
    "build:emails": "node scripts/build-emails.mjs",
    "dev:prepare": "pnpm build:emails && nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "lint": "eslint .",
    "prepack": "pnpm build:emails && nuxt-module-build build",
    "release": "npm run lint && npm run test && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "test": "pnpm build:emails && vitest run",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "test:watch": "vitest watch"
  },
  "browserslist": [
    "> 0.5% and not dead"
  ],
  "dependencies": {
    "@nuxt/kit": "3.16.2",
    "handlebars": "^4.7.9",
    "html-to-text": "^10.0.0",
    "nodemailer": "^9.0.3",
    "p-retry": "^8.0.0",
    "p-timeout": "^7.0.1"
  },
  "devDependencies": {
    "@laioutr-core/canonical-types": "0.25.0",
    "@laioutr-core/devtools": "^0.33.1",
    "@laioutr/eslint-config": "^1.8.8",
    "@laioutr/prettier-config": "^1.1.0",
    "@maizzle/framework": "^6.0.5",
    "@nuxt/devtools": "^2.6.3",
    "@nuxt/module-builder": "1.0.1",
    "@nuxt/schema": "3.16.2",
    "@nuxt/test-utils": "3.19.1",
    "@pinia/colada": "0.17.1",
    "@pinia/colada-nuxt": "0.2.1",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "latest",
    "@types/nodemailer": "^8.0.1",
    "@vueuse/core": "13.1.0",
    "changelogen": "^0.6.2",
    "eslint": "^9.35.0",
    "nuxt": "3.16.2",
    "pinia": "3.0.2",
    "typescript": "5.9.2",
    "vitest": "3.1.1",
    "vue-tsc": "2.2.10"
  },
  "peerDependencies": {
    "@laioutr-core/canonical-types": ">=0.25.0",
    "@laioutr-core/core-types": ">=0.33.1",
    "@laioutr-core/frontend-core": ">=0.33.1"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.15.0"
  }
}
